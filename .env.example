# Copy to .env (git-ignored). Never commit real values.

# --- infrastructure (docker/compose.yaml) -------------------------------------------
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me

# --- application ----------------------------------------------------------------------
# Environment file under config/environments/: shadow (default) | paper | live
SENTINEL_ENV=shadow
# Strict booleans: exactly "true" or "false". Both default to false.
# Execution additionally stays hard-disabled in code until M10.
SENTINEL_EXECUTION_ENABLED=false
# Only valid with SENTINEL_ENV=live.
SENTINEL_LIVE_TRADING_ENABLED=false
# Database (M2). Each service logs in as its own LOGIN role that is a member of one group role
# (ADR 0011). Migrations run as a separate, rarely used role that can create roles.
# SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel_ingest:change-me@127.0.0.1:5432/sentinel
# Test suite only: a disposable server, as a role that can create databases and roles.
# SENTINEL_TEST_DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/postgres

# Market data (M2): OANDA *practice* token, read-only use. Never commit a real value.
# SENTINEL_OANDA_TOKEN=
# SENTINEL_AUDIT_LOG_PATH=var/shadow/audit.jsonl
# SENTINEL_SHADOW_LOG_PATH=var/shadow/shadow_trades.jsonl
